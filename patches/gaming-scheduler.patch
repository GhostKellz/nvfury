+/*
+ * nvfury gaming-scheduler patch:
+ * Yield to other RT tasks when spinning to avoid priority inversion
+ * with compositors and other latency-sensitive processes.
+ */
+NV_STATUS NV_API_CALL os_schedule_yield_rt(void)
+{
+    if (rt_task(current))
+        yield();
+    else
+        cond_resched();
+    return NV_OK;
+}

