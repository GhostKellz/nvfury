--- a/kernel-open/nvidia/os-mlock.c
+++ b/kernel-open/nvidia/os-mlock.c
@@ -32,6 +32,7 @@
 #include <linux/slab.h>
 #include <linux/mm.h>
 #include <linux/vmalloc.h>
+#include <linux/gfp.h>

 #include "os-interface.h"
 #include "nv-linux.h"
@@ -95,7 +96,18 @@ NV_STATUS NV_API_CALL os_alloc_mem(
     {
         nv_printf(NV_DBG_MEMINFO, "NVRM: os_alloc_mem: size=%lu, flags=0x%x\n",
                   (unsigned long)size, alloc_flags);
-        p = kmalloc(size, GFP_KERNEL);
+        /*
+         * nvfury memory-optimize patch:
+         * Use GFP_NOWAIT for small allocations to avoid blocking on
+         * memory reclaim during frame rendering. Fall back to GFP_KERNEL
+         * if allocation fails.
+         *
+         * This reduces allocation latency spikes that can cause frame
+         * drops during memory pressure.
+         */
+        p = kmalloc(size, GFP_NOWAIT | __GFP_NOWARN);
+        if (p == NULL)
+            p = kmalloc(size, GFP_KERNEL);
     }

     if (p == NULL)
@@ -156,7 +168,15 @@ NV_STATUS NV_API_CALL os_alloc_contig_pages(
         return NV_ERR_INVALID_ARGUMENT;
     }

-    address = (NvUPtr)page_address(alloc_pages(gfp_mask, order));
+    /*
+     * nvfury memory-optimize patch:
+     * Add __GFP_COMP flag for compound page handling, which allows
+     * the memory to be more efficiently mapped into userspace and
+     * reduces TLB pressure through transparent huge page support.
+     */
+    gfp_mask |= __GFP_COMP;
+
+    address = (NvUPtr)page_address(alloc_pages(gfp_mask | __GFP_NOWARN, order));

     if (address == (NvUPtr)NULL)
     {
